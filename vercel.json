{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(?:case-studies|experiments|frameworks|observatory|case-study|experiment|framework)(?:/.*)?", "dest": "/app-shell.html" }
  ]
}
